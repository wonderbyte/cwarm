# cwarm daemon — install per-user:
#   mkdir -p ~/.config/cwarm ~/.config/systemd/user ~/.local/state/cwarm
#   cp config.json ~/.config/cwarm/config.json
#   cp systemd/cwarm.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cwarm
#   loginctl enable-linger "$USER"   # so it runs without an active login session
#
# Logs: journalctl --user -u cwarm -f
# ExecStart assumes `cwarm` is at ~/.local/bin/cwarm (pipx). Adjust if you
# installed into a venv, e.g. %h/path/to/.venv/bin/cwarm.

[Unit]
Description=cwarm session warmup daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cwarm --config %h/.config/cwarm/config.json --log-file %h/.local/state/cwarm/cwarm.log daemon
# always (not on-failure): bring the daemon back even on a clean/unexpected exit.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
